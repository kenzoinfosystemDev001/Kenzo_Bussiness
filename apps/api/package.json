{
  "name": "@kenzo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kenzo-Kore BusinessOS API — NestJS modular monolith",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/dev-api.mjs",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "db:migrate": "node ../../scripts/with-env.mjs prisma migrate deploy",
    "db:migrate:create": "node ../../scripts/with-env.mjs prisma migrate dev --create-only",
    "db:status": "node ../../scripts/with-env.mjs prisma migrate status",
    "db:seed": "node ../../scripts/with-env.mjs tsx prisma/seed.ts",
    "db:seed:dev": "node ../../scripts/with-env.mjs tsx scripts/seed-dev.ts",
    "db:validate-migrations": "node ../../scripts/with-env.mjs tsx scripts/validate-migrations.ts",
    "db:bootstrap-admin": "node ../../scripts/with-env.mjs tsx scripts/bootstrap-admin.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@kenzo/shared": "0.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "~6.19.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.23",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "~6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6"
  }
}
