// Kenzo-Kore BusinessOS — foundation schema (Phase 01)
//
// Conventions (docs/ARCHITECTURE.md §Data):
//  - UUID primary keys generated by PostgreSQL (gen_random_uuid()).
//  - snake_case table/column names; timestamptz everywhere (UTC).
//  - Every tenant-owned table carries company_id and is queried with it.
//  - `version` columns provide optimistic concurrency for editable records.
//  - Financial history is never hard-deleted; masters use is_active / status.
//  - audit_event is append-only (enforced by trigger in the migration).
//  - Module ownership is noted per section; other modules must use the owning
//    module's service rather than querying these tables directly.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

// DATABASE_URL may be a pooled endpoint (e.g. Neon "-pooler" / PgBouncer) used by
// the application at runtime. Migrations need a direct session-level connection,
// supplied via DIRECT_DATABASE_URL (set it equal to DATABASE_URL when not pooled).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum PermissionScope {
  OWN
  DEPARTMENT
  COMPANY
}

enum AuthTokenType {
  INVITATION
  PASSWORD_RESET
}

enum ApprovalPolicyStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ApprovalStageMode {
  ANY
  ALL
}

enum ApproverType {
  ROLE
  USER
  DEPARTMENT_HEAD
  REQUESTER_MANAGER
}

enum ApprovalInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum ApprovalTaskStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
  CANCELLED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
  SKIPPED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD
}

enum NumberResetPolicy {
  NEVER
  FISCAL_YEAR
}

// ─────────────────────── Organization module ───────────────────────

/// Legal entity and tenant boundary. Every business record belongs to exactly one company.
model Company {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String        @unique @db.VarChar(32)
  legalName               String        @map("legal_name") @db.VarChar(200)
  displayName             String        @map("display_name") @db.VarChar(120)
  gstin                   String?       @db.VarChar(15)
  pan                     String?       @db.VarChar(10)
  country                 String        @default("IN") @db.Char(2)
  timezone                String        @default("Asia/Kolkata") @db.VarChar(64)
  baseCurrency            String        @default("INR") @map("base_currency") @db.Char(3)
  fiscalYearStartMonth    Int           @default(4) @map("fiscal_year_start_month") @db.SmallInt
  addressLine1            String?       @map("address_line1") @db.VarChar(200)
  addressLine2            String?       @map("address_line2") @db.VarChar(200)
  city                    String?       @db.VarChar(100)
  state                   String?       @db.VarChar(100)
  postalCode              String?       @map("postal_code") @db.VarChar(20)
  status                  CompanyStatus @default(ACTIVE)
  enforceMfaForPrivileged Boolean       @default(false) @map("enforce_mfa_for_privileged")
  version                 Int           @default(0)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById             String?       @map("created_by") @db.Uuid
  updatedById             String?       @map("updated_by") @db.Uuid

  departments        Department[]
  costCentres        CostCentre[]
  users              User[]                    @relation("UserHomeCompany")
  roles              Role[]
  roleAssignments    UserRoleAssignment[]
  approvalPolicies   ApprovalPolicy[]
  approvalInstances  ApprovalInstance[]
  delegations        ApprovalDelegation[]
  auditEvents        AuditEvent[]
  documents          Document[]
  notifications      Notification[]
  integrationConfigs IntegrationConfig[]
  numberingSeries    NumberingSeries[]
  generatedNumbers   GeneratedNumber[]
  outboxEvents       OutboxEvent[]
  sessions           Session[]
  vendors            Vendor[]
  vendorContacts     VendorContact[]
  vendorBankAccounts VendorBankAccount[]
  vendorBankChanges  VendorBankChangeRequest[]
  vendorDocuments    VendorDocument[]

  @@map("company")
}

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  code        String   @db.VarChar(32)
  name        String   @db.VarChar(120)
  parentId    String?  @map("parent_id") @db.Uuid
  headUserId  String?  @map("head_user_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent          Department?          @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Department[]         @relation("DepartmentTree")
  head            User?                @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)
  members         User[]               @relation("UserDepartment")
  costCentres     CostCentre[]
  roleAssignments UserRoleAssignment[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, isActive])
  @@map("department")
}

model CostCentre {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  code         String   @db.VarChar(32)
  name         String   @db.VarChar(120)
  departmentId String?  @map("department_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?  @map("created_by") @db.Uuid
  updatedById  String?  @map("updated_by") @db.Uuid

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([companyId, code])
  @@index([companyId, departmentId])
  @@map("cost_centre")
}

// ───────────────────────── Identity module ─────────────────────────

/// A person who can sign in. `companyId` is the home company; access to other
/// companies comes only from role assignments scoped to those companies.
model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String     @map("company_id") @db.Uuid
  email               String     @unique @db.VarChar(254)
  fullName            String     @map("full_name") @db.VarChar(120)
  jobTitle            String?    @map("job_title") @db.VarChar(120)
  passwordHash        String?    @map("password_hash") @db.VarChar(255)
  status              UserStatus @default(INVITED)
  departmentId        String?    @map("department_id") @db.Uuid
  managerId           String?    @map("manager_id") @db.Uuid
  identityProvider    String?    @map("identity_provider") @db.VarChar(64)
  identitySubject     String?    @map("identity_subject") @db.VarChar(255)
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEnc        String?    @map("mfa_secret_enc") @db.VarChar(512)
  mfaPendingSecretEnc String?    @map("mfa_pending_secret_enc") @db.VarChar(512)
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  activatedAt         DateTime?  @map("activated_at") @db.Timestamptz(6)
  deactivatedAt       DateTime?  @map("deactivated_at") @db.Timestamptz(6)
  version             Int        @default(0)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById         String?    @map("created_by") @db.Uuid
  updatedById         String?    @map("updated_by") @db.Uuid

  company              Company                   @relation("UserHomeCompany", fields: [companyId], references: [id], onDelete: Restrict)
  department           Department?               @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  manager              User?                     @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports              User[]                    @relation("UserManager")
  headOf               Department[]              @relation("DepartmentHead")
  roleAssignments      UserRoleAssignment[]      @relation("AssignmentUser")
  grantedAssignments   UserRoleAssignment[]      @relation("AssignmentGrantedBy")
  sessions             Session[]
  authTokens           AuthToken[]
  approvalTasks        ApprovalTask[]            @relation("TaskAssignee")
  delegatedTasks       ApprovalTask[]            @relation("TaskDelegatedFrom")
  decidedTasks         ApprovalTask[]            @relation("TaskDecidedBy")
  requestedApprovals   ApprovalInstance[]        @relation("InstanceRequester")
  delegationsGiven     ApprovalDelegation[]      @relation("Delegator")
  delegationsReceived  ApprovalDelegation[]      @relation("Delegate")
  notifications        Notification[]
  auditEvents          AuditEvent[]
  uploadedDocuments    Document[]
  vendorsCreated       Vendor[]                  @relation("VendorCreatedBy")
  bankChangesRequested VendorBankChangeRequest[] @relation("BankChangeRequestedBy")
  vendorDocsVerified   VendorDocument[]          @relation("VendorDocVerifiedBy")
  vendorDocsUploaded   VendorDocument[]          @relation("VendorDocUploadedBy")
  bankAccountsVerified VendorBankAccount[]       @relation("BankAccountVerifiedBy")
  vendorStatusChanges  VendorStatusHistory[]

  @@unique([identityProvider, identitySubject])
  @@index([companyId, status])
  @@index([departmentId])
  @@map("app_user")
}

/// Server-side session. The cookie holds an opaque random token; only its
/// SHA-256 hash is stored, so a database leak does not yield usable sessions.
model Session {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  activeCompanyId String    @map("active_company_id") @db.Uuid
  mfaPending      Boolean   @default(false) @map("mfa_pending")
  mfaVerifiedAt   DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  ipAddress       String?   @map("ip_address") @db.VarChar(64)
  userAgent       String?   @map("user_agent") @db.VarChar(512)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?   @map("revoked_reason") @db.VarChar(100)

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompany Company @relation(fields: [activeCompanyId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("session")
}

/// Single-use tokens for invitations and password resets (hash stored only).
model AuthToken {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  type        AuthTokenType
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?       @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_token")
}

// ────────────────────── Access-control module ──────────────────────

model Permission {
  key         String   @id @db.VarChar(64)
  module      String   @db.VarChar(40)
  description String   @db.VarChar(255)
  sensitive   Boolean  @default(false)
  requiresMfa Boolean  @default(false) @map("requires_mfa")
  scopable    Boolean  @default(false)
  phase       Int      @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permission")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  key         String   @db.VarChar(32)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([companyId, key])
  @@unique([companyId, id])
  @@map("role")
}

model RolePermission {
  roleId        String          @map("role_id") @db.Uuid
  permissionKey String          @map("permission_key") @db.VarChar(64)
  scope         PermissionScope @default(COMPANY)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permission")
}

/// Grants a role to a user within one company. Optional department narrows the
/// DEPARTMENT scope to that department; validUntil supports time-bound access
/// (e.g. auditors). Revocation is a soft end-date so history is preserved.
model UserRoleAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  validFrom    DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime? @map("valid_until") @db.Timestamptz(6)
  grantedById  String?   @map("granted_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById  String?   @map("revoked_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User        @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  role       Role        @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  grantedBy  User?       @relation("AssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId, companyId, revokedAt])
  @@index([companyId, roleId])
  @@map("user_role_assignment")
}

// ───────────────────────── Workflow module ─────────────────────────

/// Versioned approval policy. Each (company, entity_type) has at most one ACTIVE
/// version (partial unique index in migration). Instances pin the version used.
model ApprovalPolicy {
  id                            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                     String               @map("company_id") @db.Uuid
  entityType                    String               @map("entity_type") @db.VarChar(40)
  name                          String               @db.VarChar(120)
  description                   String?              @db.VarChar(1000)
  policyVersion                 Int                  @map("policy_version")
  status                        ApprovalPolicyStatus @default(DRAFT)
  requireIndependentApproval    Boolean              @default(true) @map("require_independent_approval")
  distinctApproversAcrossStages Boolean              @default(true) @map("distinct_approvers_across_stages")
  allowDelegation               Boolean              @default(true) @map("allow_delegation")
  excludeInitiatorFromAllStages Boolean              @default(true) @map("exclude_initiator_from_all_stages")
  publishedAt                   DateTime?            @map("published_at") @db.Timestamptz(6)
  publishedById                 String?              @map("published_by") @db.Uuid
  retiredAt                     DateTime?            @map("retired_at") @db.Timestamptz(6)
  version                       Int                  @default(0)
  createdAt                     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById                   String?              @map("created_by") @db.Uuid
  updatedById                   String?              @map("updated_by") @db.Uuid

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stages    ApprovalPolicyStage[]
  instances ApprovalInstance[]

  @@unique([companyId, entityType, policyVersion])
  @@index([companyId, entityType, status])
  @@map("approval_policy")
}

model ApprovalPolicyStage {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId          String            @map("policy_id") @db.Uuid
  sequence          Int               @db.SmallInt
  name              String            @db.VarChar(120)
  mode              ApprovalStageMode @default(ANY)
  minApprovals      Int               @default(1) @map("min_approvals") @db.SmallInt
  minAmount         Decimal?          @map("min_amount") @db.Decimal(18, 2)
  maxAmount         Decimal?          @map("max_amount") @db.Decimal(18, 2)
  departmentIds     String[]          @default([]) @map("department_ids") @db.Uuid
  categoryKeys      String[]          @default([]) @map("category_keys") @db.VarChar(64)
  approverType      ApproverType      @map("approver_type")
  approverRoleKey   String?           @map("approver_role_key") @db.VarChar(32)
  approverUserId    String?           @map("approver_user_id") @db.Uuid
  slaHours          Int?              @map("sla_hours")
  escalationRoleKey String?           @map("escalation_role_key") @db.VarChar(32)

  policy ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  tasks  ApprovalTask[]

  @@index([policyId, sequence])
  @@map("approval_policy_stage")
}

model ApprovalInstance {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String                 @map("company_id") @db.Uuid
  policyId        String                 @map("policy_id") @db.Uuid
  entityType      String                 @map("entity_type") @db.VarChar(40)
  entityId        String                 @map("entity_id") @db.Uuid
  entityReference String?                @map("entity_reference") @db.VarChar(64)
  entitySummary   String?                @map("entity_summary") @db.VarChar(300)
  amount          Decimal?               @db.Decimal(18, 2)
  currencyCode    String?                @map("currency_code") @db.Char(3)
  departmentId    String?                @map("department_id") @db.Uuid
  categoryKey     String?                @map("category_key") @db.VarChar(64)
  requesterId     String                 @map("requester_id") @db.Uuid
  excludedUserIds String[]               @default([]) @map("excluded_user_ids") @db.Uuid
  status          ApprovalInstanceStatus @default(PENDING)
  currentSequence Int?                   @map("current_sequence") @db.SmallInt
  submittedAt     DateTime               @default(now()) @map("submitted_at") @db.Timestamptz(6)
  completedAt     DateTime?              @map("completed_at") @db.Timestamptz(6)
  outcomeReason   String?                @map("outcome_reason") @db.VarChar(2000)
  version         Int                    @default(0)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  policy    ApprovalPolicy  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  requester User            @relation("InstanceRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  tasks     ApprovalTask[]
  events    ApprovalEvent[]

  @@index([companyId, entityType, entityId])
  @@index([companyId, status, submittedAt])
  @@index([requesterId, status])
  @@map("approval_instance")
}

model ApprovalTask {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId      String             @map("instance_id") @db.Uuid
  stageId         String             @map("stage_id") @db.Uuid
  sequence        Int                @db.SmallInt
  assigneeId      String             @map("assignee_id") @db.Uuid
  delegatedFromId String?            @map("delegated_from_id") @db.Uuid
  isEscalation    Boolean            @default(false) @map("is_escalation")
  status          ApprovalTaskStatus @default(WAITING)
  decidedById     String?            @map("decided_by") @db.Uuid
  reason          String?            @db.VarChar(2000)
  activatedAt     DateTime?          @map("activated_at") @db.Timestamptz(6)
  dueAt           DateTime?          @map("due_at") @db.Timestamptz(6)
  escalatedAt     DateTime?          @map("escalated_at") @db.Timestamptz(6)
  decidedAt       DateTime?          @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  instance      ApprovalInstance    @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  stage         ApprovalPolicyStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  assignee      User                @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  delegatedFrom User?               @relation("TaskDelegatedFrom", fields: [delegatedFromId], references: [id], onDelete: Restrict)
  decidedBy     User?               @relation("TaskDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([assigneeId, status])
  @@index([instanceId, sequence])
  @@index([status, dueAt])
  @@map("approval_task")
}

/// Immutable approval timeline (submitted, approved, delegated, escalated …).
model ApprovalEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId String   @map("instance_id") @db.Uuid
  taskId     String?  @map("task_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  type       String   @db.VarChar(40)
  sequence   Int?     @db.SmallInt
  reason     String?  @db.VarChar(2000)
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict)

  @@index([instanceId, occurredAt])
  @@map("approval_event")
}

model ApprovalDelegation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  delegatorId String    @map("delegator_id") @db.Uuid
  delegateId  String    @map("delegate_id") @db.Uuid
  entityTypes String[]  @default([]) @map("entity_types") @db.VarChar(40)
  validFrom   DateTime  @map("valid_from") @db.Timestamptz(6)
  validUntil  DateTime  @map("valid_until") @db.Timestamptz(6)
  reason      String    @db.VarChar(500)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  delegator User    @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Restrict)
  delegate  User    @relation("Delegate", fields: [delegateId], references: [id], onDelete: Restrict)

  @@index([companyId, delegatorId, validUntil])
  @@map("approval_delegation")
}

// ─────────────────────────── Audit module ──────────────────────────

/// Append-only. UPDATE/DELETE are rejected by a database trigger.
model AuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(100)
  entityType    String   @map("entity_type") @db.VarChar(64)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  beforeHash    String?  @map("before_hash") @db.Char(64)
  afterHash     String?  @map("after_hash") @db.Char(64)
  reason        String?  @db.VarChar(2000)
  outcome       String   @default("SUCCESS") @db.VarChar(16)
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, occurredAt(sort: Desc)])
  @@index([companyId, entityType, entityId])
  @@index([actorId, occurredAt(sort: Desc)])
  @@map("audit_event")
}

// ───────────────────────── Documents module ────────────────────────

/// Metadata only — file bytes live in object storage under a random key.
model Document {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  storageProvider String             @default("local") @map("storage_provider") @db.VarChar(20)
  objectKey       String             @unique @map("object_key") @db.VarChar(255)
  originalName    String             @map("original_name") @db.VarChar(255)
  mimeType        String             @map("mime_type") @db.VarChar(100)
  sizeBytes       Int                @map("size_bytes")
  sha256          String             @db.Char(64)
  scanStatus      DocumentScanStatus @default(PENDING) @map("scan_status")
  classification  String             @default("INTERNAL") @db.VarChar(20)
  uploadedById    String             @map("uploaded_by") @db.Uuid
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  uploadedBy      User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  links           DocumentLink[]
  vendorDocuments VendorDocument[]
  bankProofs      VendorBankAccount[]

  @@index([companyId, createdAt])
  @@index([companyId, sha256])
  @@map("document")
}

model DocumentLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String   @map("entity_id") @db.Uuid
  linkType    String   @default("ATTACHMENT") @map("link_type") @db.VarChar(40)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, entityType, entityId, linkType])
  @@index([entityType, entityId])
  @@map("document_link")
}

// ─────────────────────── Notifications module ──────────────────────

model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(64)
  title      String    @db.VarChar(200)
  body       String?   @db.VarChar(2000)
  entityType String?   @map("entity_type") @db.VarChar(64)
  entityId   String?   @map("entity_id") @db.Uuid
  link       String?   @db.VarChar(300)
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notification")
}

// ─────────────────────── Integrations module ───────────────────────

/// Non-secret integration settings. `secretRef` names a secret in the secret
/// manager / environment; secret values are never stored in this table.
model IntegrationConfig {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  kind        String    @db.VarChar(20)
  provider    String    @db.VarChar(40)
  name        String    @db.VarChar(120)
  enabled     Boolean   @default(false)
  settings    Json      @default("{}")
  secretRef   String?   @map("secret_ref") @db.VarChar(200)
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz(6)
  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, kind, provider])
  @@map("integration_config")
}

// ───────────────────────── Numbering module ────────────────────────

/// One row per (company, document type, fiscal year). Allocation uses an
/// atomic UPDATE … RETURNING so concurrent transactions never share a number.
model NumberingSeries {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  documentType String            @map("document_type") @db.VarChar(40)
  periodKey    String            @default("ALL") @map("period_key") @db.VarChar(16)
  prefix       String            @db.VarChar(10)
  pattern      String            @db.VarChar(64)
  padding      Int               @default(6) @db.SmallInt
  resetPolicy  NumberResetPolicy @default(FISCAL_YEAR) @map("reset_policy")
  nextValue    BigInt            @default(1) @map("next_value")
  isTemplate   Boolean           @default(false) @map("is_template")
  version      Int               @default(0)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, documentType, periodKey])
  @@map("numbering_series")
}

/// Registry of issued numbers — guarantees (company, document_type, number) uniqueness
/// and links each number to the record that consumed it.
model GeneratedNumber {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(40)
  number       String   @db.VarChar(64)
  entityId     String?  @map("entity_id") @db.Uuid
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById   String?  @map("issued_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, number, documentType])
  @@map("generated_number")
}

// ─────────────────────────── Outbox (infra) ────────────────────────

/// Transactional outbox: domain events written in the same transaction as the
/// business change, then dispatched asynchronously with retries.
model OutboxEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String?      @map("company_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.VarChar(64)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  lastError     String?      @map("last_error") @db.VarChar(2000)
  correlationId String?      @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@map("outbox_event")
}

// ═════════════════════════ Vendors module (Phase 02) ═════════════════════════

enum VendorStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum VendorType {
  GOODS_SUPPLIER
  SERVICE_PROVIDER
  CONTRACTOR
  CONSULTANT
  DISTRIBUTOR
  MANUFACTURER
  OTHER
}

enum GstRegistrationType {
  REGISTERED
  COMPOSITION
  SEZ
  UNREGISTERED
  OVERSEAS
}

enum VendorDocumentType {
  GST_CERTIFICATE
  PAN_CARD
  INCORPORATION
  BANK_PROOF
  CONTRACT
  AGREEMENT
  MSME_CERTIFICATE
  COMPLIANCE_CERTIFICATE
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BankAccountStatus {
  PROPOSED
  ACTIVE
  SUPERSEDED
  REJECTED
}

enum BankAccountType {
  CURRENT
  SAVINGS
  CASH_CREDIT
  OVERSEAS
}

enum BankChangeStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

/// Vendor master: the single source of truth reused by RFQs, POs, receipts, invoices and payments.
/// Restricted identifiers (PAN, bank account numbers) are stored encrypted with a keyed
/// fingerprint for duplicate detection and the last 4 characters for masked display.
model Vendor {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String              @map("company_id") @db.Uuid
  vendorCode              String              @map("vendor_code") @db.VarChar(64)
  legalName               String              @map("legal_name") @db.VarChar(200)
  tradeName               String?             @map("trade_name") @db.VarChar(200)
  normalizedName          String              @map("normalized_name") @db.VarChar(200)
  vendorType              VendorType          @map("vendor_type")
  category                String              @db.VarChar(80)
  gstRegistrationType     GstRegistrationType @map("gst_registration_type")
  gstin                   String?             @db.VarChar(15)
  panEnc                  String?             @map("pan_enc") @db.VarChar(256)
  panLast4                String?             @map("pan_last4") @db.VarChar(4)
  panFingerprint          String?             @map("pan_fingerprint") @db.Char(64)
  registrationNumber      String?             @map("registration_number") @db.VarChar(40)
  msmeRegistered          Boolean             @default(false) @map("msme_registered")
  msmeNumber              String?             @map("msme_number") @db.VarChar(40)
  website                 String?             @db.VarChar(200)
  email                   String?             @db.VarChar(254)
  phone                   String?             @db.VarChar(20)
  addressLine1            String              @map("address_line1") @db.VarChar(200)
  addressLine2            String?             @map("address_line2") @db.VarChar(200)
  city                    String              @db.VarChar(100)
  state                   String              @db.VarChar(100)
  stateCode               String?             @map("state_code") @db.VarChar(2)
  postalCode              String              @map("postal_code") @db.VarChar(20)
  country                 String              @default("IN") @db.Char(2)
  paymentTermsDays        Int                 @default(30) @map("payment_terms_days") @db.SmallInt
  preferredCurrency       String              @default("INR") @map("preferred_currency") @db.Char(3)
  internalNotes           String?             @map("internal_notes") @db.VarChar(4000)
  status                  VendorStatus        @default(DRAFT)
  statusReason            String?             @map("status_reason") @db.VarChar(1000)
  submittedAt             DateTime?           @map("submitted_at") @db.Timestamptz(6)
  approvedAt              DateTime?           @map("approved_at") @db.Timestamptz(6)
  activatedAt             DateTime?           @map("activated_at") @db.Timestamptz(6)
  suspendedAt             DateTime?           @map("suspended_at") @db.Timestamptz(6)
  archivedAt              DateTime?           @map("archived_at") @db.Timestamptz(6)
  duplicateOverrideReason String?             @map("duplicate_override_reason") @db.VarChar(1000)
  version                 Int                 @default(0)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById             String              @map("created_by") @db.Uuid
  updatedById             String?             @map("updated_by") @db.Uuid

  company       Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy     User                      @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  contacts      VendorContact[]
  bankAccounts  VendorBankAccount[]
  bankChanges   VendorBankChangeRequest[]
  documents     VendorDocument[]
  statusHistory VendorStatusHistory[]

  @@unique([companyId, vendorCode])
  @@unique([companyId, id])
  @@index([companyId, status, createdAt])
  @@index([companyId, normalizedName])
  @@index([companyId, panFingerprint])
  @@map("vendor")
}

model VendorContact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  name        String   @db.VarChar(120)
  designation String?  @db.VarChar(120)
  email       String?  @db.VarChar(254)
  phone       String?  @db.VarChar(20)
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vendor  Vendor  @relation(fields: [companyId, vendorId], references: [companyId, id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_contact")
}

/// Bank accounts are never edited in place: a change creates a new PROPOSED row that
/// becomes ACTIVE only through maker-checker approval; the old row becomes SUPERSEDED.
model VendorBankAccount {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String            @map("company_id") @db.Uuid
  vendorId           String            @map("vendor_id") @db.Uuid
  accountHolderName  String            @map("account_holder_name") @db.VarChar(200)
  bankName           String            @map("bank_name") @db.VarChar(120)
  branchName         String?           @map("branch_name") @db.VarChar(120)
  ifsc               String?           @db.VarChar(11)
  swiftCode          String?           @map("swift_code") @db.VarChar(11)
  accountType        BankAccountType   @default(CURRENT) @map("account_type")
  accountNumberEnc   String            @map("account_number_enc") @db.VarChar(256)
  accountLast4       String            @map("account_last4") @db.VarChar(4)
  accountFingerprint String            @map("account_fingerprint") @db.Char(64)
  status             BankAccountStatus @default(PROPOSED)
  proofDocumentId    String?           @map("proof_document_id") @db.Uuid
  verifiedById       String?           @map("verified_by") @db.Uuid
  verifiedAt         DateTime?         @map("verified_at") @db.Timestamptz(6)
  supersededAt       DateTime?         @map("superseded_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        String            @map("created_by") @db.Uuid

  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vendor         Vendor                    @relation(fields: [companyId, vendorId], references: [companyId, id], onDelete: Restrict)
  proofDocument  Document?                 @relation(fields: [proofDocumentId], references: [id], onDelete: Restrict)
  verifiedBy     User?                     @relation("BankAccountVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  changeRequests VendorBankChangeRequest[] @relation("ProposedAccount")
  replacedBy     VendorBankChangeRequest[] @relation("PreviousAccount")

  @@index([vendorId, status])
  @@index([companyId, accountFingerprint])
  @@map("vendor_bank_account")
}

model VendorBankChangeRequest {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  vendorId          String           @map("vendor_id") @db.Uuid
  proposedAccountId String           @map("proposed_account_id") @db.Uuid
  previousAccountId String?          @map("previous_account_id") @db.Uuid
  reason            String           @db.VarChar(1000)
  status            BankChangeStatus @default(PENDING_APPROVAL)
  outcomeReason     String?          @map("outcome_reason") @db.VarChar(2000)
  requestedById     String           @map("requested_by") @db.Uuid
  decidedAt         DateTime?        @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vendor          Vendor             @relation(fields: [companyId, vendorId], references: [companyId, id], onDelete: Restrict)
  proposedAccount VendorBankAccount  @relation("ProposedAccount", fields: [proposedAccountId], references: [id], onDelete: Restrict)
  previousAccount VendorBankAccount? @relation("PreviousAccount", fields: [previousAccountId], references: [id], onDelete: Restrict)
  requestedBy     User               @relation("BankChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([companyId, status, createdAt])
  @@index([vendorId])
  @@map("vendor_bank_change_request")
}

/// Versioned vendor documents. A replacement creates version n+1 and flips
/// is_current on the previous row; history is never deleted.
model VendorDocument {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String                     @map("company_id") @db.Uuid
  vendorId           String                     @map("vendor_id") @db.Uuid
  documentId         String                     @map("document_id") @db.Uuid
  documentType       VendorDocumentType         @map("document_type")
  title              String                     @db.VarChar(200)
  documentNumber     String?                    @map("document_number") @db.VarChar(80)
  issueDate          DateTime?                  @map("issue_date") @db.Date
  expiryDate         DateTime?                  @map("expiry_date") @db.Date
  versionNo          Int                        @default(1) @map("version_no")
  previousVersionId  String?                    @map("previous_version_id") @db.Uuid
  isCurrent          Boolean                    @default(true) @map("is_current")
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  verificationNote   String?                    @map("verification_note") @db.VarChar(1000)
  verifiedById       String?                    @map("verified_by") @db.Uuid
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(6)
  expiryWarnedAt     DateTime?                  @map("expiry_warned_at") @db.Timestamptz(6)
  expiredNotifiedAt  DateTime?                  @map("expired_notified_at") @db.Timestamptz(6)
  uploadedById       String                     @map("uploaded_by") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vendor          Vendor           @relation(fields: [companyId, vendorId], references: [companyId, id], onDelete: Restrict)
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  previousVersion VendorDocument?  @relation("DocumentVersions", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersions    VendorDocument[] @relation("DocumentVersions")
  verifiedBy      User?            @relation("VendorDocVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  uploadedBy      User             @relation("VendorDocUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([vendorId, documentType, isCurrent])
  @@index([companyId, verificationStatus])
  @@index([companyId, expiryDate])
  @@map("vendor_document")
}

/// Append-only lifecycle trail: every transition with actor, timestamp and reason.
model VendorStatusHistory {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId   String        @map("vendor_id") @db.Uuid
  fromStatus VendorStatus? @map("from_status")
  toStatus   VendorStatus  @map("to_status")
  actorId    String?       @map("actor_id") @db.Uuid
  reason     String?       @db.VarChar(2000)
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([vendorId, occurredAt])
  @@map("vendor_status_history")
}
