{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    // No "types" entry on purpose: nothing here touches Node APIs, so the package
    // compiles without @types/node. Requiring it made `npm install --omit=dev`
    // fail the root postinstall, which builds this package.
    "types": []
  },
  "include": ["src/**/*.ts"]
}
