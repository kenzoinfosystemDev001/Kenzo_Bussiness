{
  "name": "kenzo-kore-businessos",
  "version": "0.1.0",
  "private": true,
  "description": "Kenzo-Kore BusinessOS — internal business operations platform (modular monolith)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10"
  },
  "scripts": {
    "build:shared": "npm run build -w @kenzo/shared",
    "build": "npm run build:shared && npm run build -w @kenzo/api && npm run build -w @kenzo/web",
    "start": "npm run start -w @kenzo/api",
    "dev:api": "npm run dev -w @kenzo/api",
    "dev:web": "npm run dev -w @kenzo/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run build:shared && npm run typecheck -w @kenzo/api && npm run typecheck -w @kenzo/web",
    "test": "npm run test -w @kenzo/shared && npm run test -w @kenzo/api && npm run test -w @kenzo/web",
    "test:unit": "npm run test -w @kenzo/shared && npm run test:unit -w @kenzo/api && npm run test -w @kenzo/web",
    "test:integration": "npm run test:integration -w @kenzo/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @kenzo/api",
    "db:seed": "npm run db:seed -w @kenzo/api",
    "db:validate-migrations": "npm run db:validate-migrations -w @kenzo/api",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "postinstall": "npm run build:shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
