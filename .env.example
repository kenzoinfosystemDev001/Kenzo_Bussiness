# ─────────────────────────────────────────────────────────────────────────────
# Kenzo-Kore BusinessOS — environment template.
# Copy to `.env` (git-ignored) for local development. In deployed environments
# inject these from the secret manager; never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL. Local default matches docker-compose.yml.
# With a pooled endpoint (Neon "-pooler", PgBouncer) put the pooled URL in DATABASE_URL
# and the direct (non-pooled) URL in DIRECT_DATABASE_URL — Prisma Migrate needs it.
# Without pooling, set both to the same value.
DATABASE_URL=postgresql://kenzo:kenzo_local_dev_only@127.0.0.1:55432/kenzo_kore?schema=public
DIRECT_DATABASE_URL=postgresql://kenzo:kenzo_local_dev_only@127.0.0.1:55432/kenzo_kore?schema=public
# Integration tests use a separate database (created by infra/docker/postgres-init.sql).
TEST_DATABASE_URL=postgresql://kenzo:kenzo_local_dev_only@127.0.0.1:55432/kenzo_kore_test?schema=public

# API
PORT=4000
# Origin of the web app. State-changing requests from any other Origin are rejected.
APP_ORIGIN=http://localhost:3001
# Where the Next.js server proxies /api/* (server-side only, never exposed to the browser).
API_INTERNAL_URL=http://127.0.0.1:4000

# Secrets — generate fresh values:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   → SESSION_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      → DATA_ENCRYPTION_KEY
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Defaults to true when NODE_ENV=production. Must be true behind HTTPS.
# COOKIE_SECURE=false
# Set true only when running behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false

# Abuse protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# Documents (private storage — never inside a web-served directory)
DOCUMENT_STORAGE_DIR=storage/documents
DOCUMENT_MAX_BYTES=15728640
# none | required  (required blocks downloads until a scanner marks files CLEAN)
DOCUMENT_SCAN_MODE=none

# Background work (0 disables the in-process poller)
OUTBOX_POLL_MS=5000
ESCALATION_POLL_MS=900000

# Mail: `log` prints messages in development (bodies suppressed in production).
MAIL_TRANSPORT=log
MAIL_FROM=Kenzo-Kore BusinessOS <no-reply@kenzo.local>

LOG_LEVEL=info

# First administrator (used once by `npm run db:bootstrap-admin`)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_COMPANY_CODE=KENZO
BOOTSTRAP_COMPANY_LEGAL_NAME=Kenzo Infosystems Pvt. Ltd.
BOOTSTRAP_COMPANY_DISPLAY_NAME=Kenzo Infosystems
